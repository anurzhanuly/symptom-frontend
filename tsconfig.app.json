{
    "extends": "@vue/tsconfig/tsconfig.web.json",
    "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
    "exclude": ["src/**/__tests__/*"],
    "compilerOptions": {
        "composite": true,
        "baseUrl": ".",
        "lib": ["esnext", "dom"],
        "paths": {
            "@mobile*": ["./src/mobile*"],
            "@desktop*": ["./src/desktop*"]
        },
        "jsx": "preserve"
    }
}
